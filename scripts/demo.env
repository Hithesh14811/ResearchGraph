# Offline demo configuration for the API server:
#   uvicorn researchgraph.main:create_app --factory --env-file scripts/demo.env
# Deterministic mock model + synthetic corpus; no API keys or network needed.
LLM_PROVIDER=mock
MODEL_NAME=mock-research-model
SEARCH_PROVIDER=mock
EMBEDDING_PROVIDER=hashing
VECTOR_STORE=memory
DATABASE_URL=sqlite+aiosqlite:///./data/researchgraph.db
# Slow the mock model down a little so the live dashboard is pleasant to watch.
MOCK_LLM_LATENCY_MS=350
