{
  "name": "researchgraph-core-v1",
  "description": "Research questions with the characteristics a good run should exhibit. Expectations are behavioural (grounding, coverage, honesty about gaps), not answer keys: ResearchGraph is evaluated on how it researches, not on memorised conclusions.",
  "questions": [
    {
      "id": "rag-vs-finetuning",
      "question": "Compare the effectiveness of RAG, fine-tuning, and long-context prompting for domain-specific question answering. Use recent academic papers and credible technical sources. Identify evidence, limitations, benchmarks, and practical recommendations.",
      "modes": [
        "demo",
        "live"
      ],
      "expected": {
        "min_sources": 5,
        "min_evidence": 10,
        "min_subquestion_coverage": 0.8,
        "must_cite_primary_research": true,
        "expects_contradiction": true,
        "expected_aspects": [
          [
            "retrieval",
            "rag"
          ],
          [
            "fine-tun"
          ],
          [
            "long-context",
            "long context"
          ],
          [
            "cost",
            "latency"
          ],
          [
            "accuracy",
            "exact-match",
            "benchmark"
          ],
          [
            "forgetting",
            "new facts",
            "knowledge"
          ]
        ]
      }
    },
    {
      "id": "small-vs-large-models",
      "question": "Analyze the tradeoffs between small and large language models for production inference.",
      "modes": [
        "demo",
        "live"
      ],
      "expected": {
        "min_sources": 5,
        "min_evidence": 10,
        "must_cite_primary_research": true,
        "expected_aspects": [
          [
            "accuracy",
            "reasoning"
          ],
          [
            "latency",
            "throughput"
          ],
          [
            "quantization",
            "distill"
          ],
          [
            "cost",
            "energy"
          ],
          [
            "routing",
            "cascade"
          ],
          [
            "out-of-distribution",
            "failure"
          ]
        ]
      }
    },
    {
      "id": "rag-hallucinations",
      "question": "Evaluate current approaches for reducing hallucinations in retrieval-augmented generation.",
      "modes": [
        "demo",
        "live"
      ],
      "expected": {
        "min_sources": 5,
        "min_evidence": 10,
        "must_cite_primary_research": true,
        "expected_aspects": [
          [
            "retrieval failure",
            "retrieval failures"
          ],
          [
            "citation",
