          ]
        ]
      }
    },
    {
      "id": "quantization-edge",
      "question": "Evaluate how quantization and model compression affect accuracy and serving cost for deploying language models.",
      "modes": [
        "demo",
        "live"
      ],
      "expected": {
        "min_sources": 3,
        "min_evidence": 5,
        "min_subquestion_coverage": 0.6,
        "must_cite_primary_research": true,
        "expected_aspects": [
          [
            "quantiz"
          ],
          [
            "accuracy"
          ],
          [
            "memory",
            "gpu"
          ],
          [
            "cost"
          ]
        ]
      }
    },
    {
      "id": "negative-control-off-topic",
      "question": "What are the long-term cardiovascular effects of intermittent fasting in adults over sixty?",
      "modes": [
        "demo"
      ],
      "notes": "Negative control: the synthetic demo corpus contains nothing on this topic. A trustworthy system must not fabricate support; it should report thin evidence and limitations.",
      "expected": {
        "min_sources": 0,
        "min_evidence": 0,
        "min_subquestion_coverage": 0.0,
        "min_citation_coverage": 1.0,
        "max_unsupported_claim_rate": 1.0,
        "must_cite_primary_research": false,
        "expect_limitations": true,
        "max_subquestion_coverage": 0.0
