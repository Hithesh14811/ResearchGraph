# ─────────────────────────────────────────────────────────────────────────────
# ResearchGraph configuration. Copy to .env and fill in what you need.
# Everything is optional: with no changes the system runs fully offline in demo
# mode (deterministic mock model + clearly-labelled synthetic corpus).
# ─────────────────────────────────────────────────────────────────────────────

# --- LLM provider (any provider supported by LangChain's init_chat_model) -----
# mock | openai | anthropic | google_genai | ollama | groq | mistralai | ...
LLM_PROVIDER=mock
MODEL_NAME=mock-research-model
# Optional cheaper model for high-volume steps (query writing, extraction, tool use)
FAST_MODEL_NAME=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=8192
LLM_MAX_RETRIES=3
# auto = native JSON-schema output for anthropic/openai, JSON mode when LLM_BASE_URL is set,
# integration default elsewhere. Also: function_calling | json_schema | json_mode
LLM_STRUCTURED_OUTPUT_METHOD=auto
# OpenAI-compatible endpoint (DeepSeek, vLLM, Together, ...); use with LLM_PROVIDER=openai
LLM_BASE_URL=
# Optional pricing (USD per 1M tokens) to enable cost estimates in the UI
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=
# Examples:
#   LLM_PROVIDER=anthropic  MODEL_NAME=claude-sonnet-5-5  FAST_MODEL_NAME=claude-haiku-4-5-20251001
#   LLM_PROVIDER=openai     MODEL_NAME=<your OpenAI chat model>
#   LLM_PROVIDER=openai     MODEL_NAME=deepseek-flash  LLM_BASE_URL=https://api.deepseek.com  (key in OPENAI_API_KEY)
#   LLM_PROVIDER=ollama     MODEL_NAME=llama3.1   (pip install langchain-ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Search -------------------------------------------------------------------
# mock | auto | tavily | arxiv | semantic_scholar
#   auto = Tavily web search (if TAVILY_API_KEY is set) + arXiv + Semantic Scholar
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# 'llm' lets the research worker choose tools; 'deterministic' runs planned queries
RESEARCH_AGENT_MODE=llm

# --- Embeddings & vector store ------------------------------------------------
# hashing (offline, deterministic, lexical) | openai (semantic; needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
# auto = pgvector when DATABASE_URL is PostgreSQL, otherwise in-memory
VECTOR_STORE=auto

# --- Persistence --------------------------------------------------------------
# Local default (SQLite). Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/researchgraph.db
# DATABASE_URL=postgresql+psycopg://researchgraph:researchgraph@localhost:5432/researchgraph
# LangGraph checkpointer location (defaults next to DATABASE_URL)
CHECKPOINT_URL=

# --- Budgets & safety limits --------------------------------------------------
MAX_RESEARCH_ITERATIONS=3
MAX_TOOL_CALLS=60
MAX_PARALLEL_WORKERS=5
MAX_SUBQUESTIONS=6
MAX_DOCUMENT_BYTES=5000000
MAX_REPORT_CHARS=150000
QUALITY_GATE_THRESHOLD=0.65
MIN_EVIDENCE_PER_SUBQUESTION=2

# --- Observability (LangSmith; optional) -------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=researchgraph
LANGCHAIN_ENDPOINT=

# --- API ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# If set, every API call needs "Authorization: Bearer <token>" (or ?token= for SSE)
API_TOKEN=

# --- Live mode gate (public deployments) ----------------------------------------
# With a real LLM_PROVIDER configured: PUBLIC_DEMO=true serves the offline demo lane by
# default, and live runs need LIVE_MODE_PASSWORD (the dashboard's Demo / Live switch).
# PUBLIC_DEMO=true with no password means live runs are impossible.
PUBLIC_DEMO=false
LIVE_MODE_PASSWORD=
LIVE_TOKEN_TTL_HOURS=12
RESUME_RUNS_ON_STARTUP=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Demo mode ----------------------------------------------------------------
# Simulated failures applied to every run: failed_source, llm_timeout,
# invalid_output, insufficient_evidence, critic_rejection (or 'all')
DEMO_FAILURES=
MOCK_LLM_LATENCY_MS=0
